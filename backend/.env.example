# Server
PORT=5001

# Google Gemini Vision API Key
GEMINI_API_KEY=replace_with_your_google_ai_studio_key
GEMINI_MODEL=gemini-3.6-flash

# Neon Serverless PostgreSQL Database URL
# Format: postgresql://<user>:<password>@<endpoint>.neon.tech/<dbname>?sslmode=require&channel_binding=require
DATABASE_URL=postgresql://neondb_owner:replace_with_your_neon_db_password@ep-xyz-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Optional fallback alias for scripts/config that read NEON_DATABASE_URL
# NEON_DATABASE_URL=postgresql://neondb_owner:replace_with_your_neon_db_password@ep-xyz-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
