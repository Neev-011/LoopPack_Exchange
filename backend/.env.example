# Google Gemini Vision API Key
GEMINI_API_KEY=replace_with_your_google_ai_studio_key
GEMINI_MODEL=gemini-3.6-flash

# Neon Serverless PostgreSQL Database URL
# Format: postgres://<user>:<password>@<endpoint>.neon.tech/<dbname>?sslmode=require
DATABASE_URL=postgres://neondb_owner:replace_with_your_neon_db_password@ep-xyz-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
